FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo/phase-4/backend

# Cache npm install separately from the rest of the code.
COPY phase-4/backend/package.json phase-4/backend/package-lock.json ./
RUN npm install --omit=dev

# server.js serves static files from __dirname/.. (phase-4/), and
# db.js reads db/schema.sql + db/seed.sql from phase-4/db/, so the
# whole phase-4/ folder is needed, not just backend/.
WORKDIR /repo
COPY phase-4/ phase-4/
WORKDIR /repo/phase-4/backend

EXPOSE 3000

CMD ["node", "server.js"]